{
  "name": "prime-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker gateway for exposing local code-mcp servers via WebSocket tunneling",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "test": "bun test test/*.test.ts && bun test witness/test && bun test/run-smoke.ts && bun test/files.ts && bun test/anonymous.ts && bun test/fleet-events.ts && bun test/fleet-audit-trim.ts",
    "test:anonymous": "bun test/anonymous.ts",
    "test:files": "bun test/files.ts",
    "test:fleet-events": "bun test/fleet-events.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p witness"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "playwright": "^1.64.1",
    "sql.js": "^1.15.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.141.0"
  },
  "allowScripts": {
    "workerd@1.20250718.0": true,
    "esbuild@0.17.19": true,
    "sharp@0.33.5": true
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7"
  }
}
