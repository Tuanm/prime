{
  "name": "code-mcp-gateway-cli",
  "version": "26.10.19",
  "private": true,
  "description": "mcp - command line client for code-mcp-gateway devices and MCP tools",
  "type": "module",
  "module": "src/index.ts",
  "bin": {
    "mcp": "./src/index.ts"
  },
  "imports": {
    "#code-mcp": "./src/code-mcp.ts"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "build:host": "bun scripts/build.ts --host-only",
    "bundle": "bun scripts/build.ts --bundle-only",
    "sync:code-mcp": "bun scripts/sync-code-mcp.ts",
    "test": "bun test test/unit.test.ts test/features.test.ts test/service.test.ts",
    "test:e2e": "bun test/e2e.ts",
    "test:service": "bun test/service-e2e.ts",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "typescript": "^5.6.0"
  }
}
